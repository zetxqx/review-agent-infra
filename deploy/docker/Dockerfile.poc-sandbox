FROM golang:1.27-bookworm AS loader-builder

ENV CGO_ENABLED=0 \
    GO111MODULE=on \
    GOTOOLCHAIN=auto

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY gen/go ./gen/go
COPY pkg ./pkg
COPY internal ./internal
COPY cmd/loader ./cmd/loader
RUN go build -trimpath -ldflags="-s -w" -o /out/loader ./cmd/loader

FROM python:3.12-slim-bookworm

RUN apt-get update \
 && apt-get install -y --no-install-recommends git ripgrep ca-certificates \
 && rm -rf /var/lib/apt/lists/*

COPY --from=loader-builder /out/loader /usr/local/bin/loader
COPY gen/schema/llm_review_report.schema.json /opt/kit/share/llm_review_report.schema.json
COPY python /tmp/review-harness-kit

RUN python3 -m venv /opt/kit \
 && /opt/kit/bin/pip install --no-cache-dir /tmp/review-harness-kit \
 && rm -rf /tmp/review-harness-kit \
 && ln -s /opt/kit/bin/review-kit /usr/local/bin/review-kit \
 && cp /opt/kit/lib/python3.12/site-packages/review_harness_kit/prompts/review_task.md /opt/kit/share/review_task.md \
 && mkdir -p /workspace/src /workspace/.review/in /workspace/.review/out /scratch/home \
 && chown -R 65532:65532 /workspace /scratch

USER 65532:65532
WORKDIR /workspace
CMD ["review-kit", "wait"]
