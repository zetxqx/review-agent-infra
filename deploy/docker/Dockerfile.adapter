FROM golang:1.27-bookworm AS builder

ENV CGO_ENABLED=0 \
    GO111MODULE=on \
    GOTOOLCHAIN=auto

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY gen/go ./gen/go
COPY pkg ./pkg
COPY internal ./internal
COPY cmd/adapter ./cmd/adapter
RUN go build -trimpath -ldflags="-s -w" -o /out/adapter ./cmd/adapter

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=builder /out/adapter /usr/local/bin/adapter
USER 65532:65532
EXPOSE 8080 9090
ENTRYPOINT ["/usr/local/bin/adapter"]
